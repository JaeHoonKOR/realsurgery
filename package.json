{
  "name": "realsurgery",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/copy-fonts.mjs && node scripts/build-data.mjs && next dev",
    "preview": "node scripts/preview.mjs",
    "build": "node scripts/copy-fonts.mjs && node scripts/build-data.mjs && next build && node scripts/check-out.mjs",
    "serve": "node scripts/serve-out.mjs",
    "data": "node scripts/build-data.mjs",
    "data:sql": "node scripts/build-data.mjs --sql",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tokens.mjs && node scripts/build-data.mjs --check-sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:a11y": "playwright test tests/a11y",
    "test:e2e": "playwright test tests/e2e",
    "lh": "node scripts/lh.mjs",
    "screens": "node scripts/screens.mjs"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6"
    }
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "marked": "18.0.14",
    "next": "15",
    "pretendard": "^1.3.9",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "3",
    "chrome-launcher": "1",
    "eslint": "9",
    "eslint-config-next": "15",
    "jsdom": "25",
    "lighthouse": "12",
    "postcss": "^8.5.31",
    "sharp": "0.35.5",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "3"
  }
}
